# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# local dev-machine tooling (hardcoded absolute paths, not portable)
/.claude/launch.json
/run-dev.sh

# source brand guideline files and extraction working files (large; only the
# final processed assets in public/brand/ are needed by the app)
/brand-assets/

# typescript
*.tsbuildinfo
next-env.d.ts
